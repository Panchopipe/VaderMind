ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=250
LLM_PROVIDER=vercel
OPENROUTER_API_KEY=sk-or-v1-...
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
VADER_FAST_MODEL=google/gemini-3.5-flash-lite
VADER_QUALITY_MODEL=google/gemini-3.7-flash
# Gemini 3.7 razona antes de responder y gasta este mismo presupuesto; con 250 se cortaba.
VADER_QUALITY_MAX_OUTPUT_TOKENS=1024
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=1
AI_GATEWAY_TIMEOUT_SECONDS=30
AI_GATEWAY_MAX_RETRIES=1
AI_GATEWAY_REQUIRE_ZDR=false
# Gemini 3.5 atiende la ruta habitual; Gemini 3.7 queda para complejidad y fallback.
# Web general y deportes no estan expuestos: solo hora y clima siguen activos.
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
ELEVENLABS_API_KEY=sk_...
# ID de una voz de tu cuenta ElevenLabs; obligatorio si VADER_TTS_PROVIDER=elevenlabs.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.25
ELEVENLABS_USE_SPEAKER_BOOST=true
# Transcripcion de voz via Vercel con la misma clave; respeta AI_GATEWAY_REQUIRE_ZDR.
# gpt-4o con contexto chileno gano en la Pi (0 % de error a 1 m); grok-stt ignora el contexto.
VADER_STT_MODEL=openai/gpt-4o-transcribe
VADER_STT_FALLBACK_MODEL=spacexai/grok-stt
# Si el principal no responde en este tiempo, entra el respaldo.
VADER_STT_TIMEOUT_SECONDS=8
# Contexto para la transcripcion: 'default' (chilenismos y Vader), vacio para no enviar o un texto propio.
VADER_STT_PROMPT=default
# --listen: parte del nombre del microfono; vacio usa el predeterminado del sistema.
VADER_MIC_DEVICE=
# Silero VAD detecta el fin de habla; los sonidos pueden ser WAV propios.
VADER_VAD_MODEL_PATH=models/vad/silero_vad.onnx
VADER_LISTEN_SILENCE_MS=800
VADER_LISTEN_MAX_SECONDS=15
VADER_LISTEN_CUES=true
# Sonidos: ruta a un WAV, vacio para el bip, o "none" para silencio.
# FIRST suena solo en el primer turno de voz de la sesion, en lugar de START.
VADER_LISTEN_FIRST_SOUND=
VADER_LISTEN_START_SOUND=
VADER_LISTEN_END_SOUND=
# Transcripcion especulativa: tras esta pausa (ms) se transcribe lo dicho mientras
# Vader confirma que terminaste; si vuelves a hablar se descarta. 0 la desactiva.
VADER_STT_SPECULATIVE_MS=192
# Transcripcion en streaming (beta de Vercel, encendida desde el 20/11/2026): el audio
# viaja mientras hablas y en la pausa el texto llega en ~0,3 s. Si falla o tarda, se usa
# la transcripcion de arriba (false la apaga). grok-stt recibe espanol y los chilenismos
# como palabras clave (con VADER_STT_PROMPT=default).
VADER_STT_STREAMING=true
VADER_STT_STREAMING_MODEL=spacexai/grok-stt
# --manos-libres: palabra de activacion local con Vosk (modelo fuera de Git).
VADER_WAKE_MODEL_PATH=models/vosk/vosk-model-small-es-0.42
VADER_WAKE_PHRASE=oye vader
# Otras formas aceptadas, separadas por coma: "oye bei der" es "Oye Veider" con
# palabras que Vosk conoce. Una sola variante: varias parecidas se restan confianza.
VADER_WAKE_VARIANTS=oye bei der
# 0 a 1: confianza minima de cada palabra; mas alto = mas estricto, pero pierde aciertos.
VADER_WAKE_MIN_CONFIDENCE=0.5
# Segundos para seguir hablando sin repetir la palabra tras cada respuesta;
# 0 la desactiva. "Vader, silencio" la cierra al tiro.
VADER_FOLLOW_UP_SECONDS=10
# "Vader, apagate" apaga la Raspberry tras confirmar por voz (solo Linux).
VADER_ALLOW_SHUTDOWN=false
# Luces de los ojos: none, console (Windows) o ws2812 (Raspberry por SPI).
VADER_LIGHTS=none
VADER_LIGHTS_SPI_DEVICE=/dev/spidev0.0
VADER_LIGHTS_BRIGHTNESS=0.10
VADER_LIGHTS_EYES=2
# Posicion del LED central (pupila) dentro de cada modulo de 7.
VADER_LIGHTS_CENTER_INDEX=0
VADER_TTS_STREAMING=false
VADER_TTS_PROVIDER=piper
VADER_SAVE_LAST_AUDIO=true
# Mantiene Piper abierto con el modelo cargado; false lanza un proceso por respuesta.
PIPER_PERSISTENT=true
PIPER_EXECUTABLE=.runtime_cache/piper_windows_amd64/piper/piper.exe
PIPER_MODEL_PATH=models/piper/es_CL-vader-medium/es_CL-vader-medium.onnx
PIPER_CONFIG_PATH=models/piper/es_CL-vader-medium/es_CL-vader-medium.onnx.json
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8
PIPER_SENTENCE_SILENCE=0.2
PIPER_TIMEOUT_SECONDS=60
SPOTIFY_CLIENT_ID=tu_client_id_de_spotify
SPOTIFY_CLIENT_SECRET=tu_client_secret_de_spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
SPOTIFY_TOKEN_CACHE_PATH=.spotify_token.json
SPOTIFY_PLAYLIST_ALIASES_PATH=.spotify_playlist_aliases.json
SPOTIFY_MARKET=CL
SPOTIFY_DEVICE_NAME=
LG_TV_HOST=
LG_TV_MAC=
LG_TV_BROADCAST_ADDRESS=255.255.255.255
LG_TV_CLIENT_KEY_PATH=.lg_tv_client_key
LG_TV_SCHEDULES_PATH=.lg_tv_schedules.json
LG_TV_TIMEOUT_SECONDS=5
LG_TV_WAKE_TIMEOUT_SECONDS=40
SPOTIFY_TV_DEVICE_NAME=
VADER_LANGUAGE=es
# Modo al arrancar: 'canon' o 'chileno'. En manos libres, "Vader, modo canon/chileno" lo cambia hasta reiniciar.
VADER_PERSONA_MODE=canon
VADER_DEBUG=false
