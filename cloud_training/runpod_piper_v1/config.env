# Entorno persistente de la ejecución en RunPod.
RUN_ROOT="${RUN_ROOT:-/workspace/vader_piper_run}"

# Piper de entrenamiento compatible con checkpoints piper_version=1.0.0.
PIPER_REPO_URL="https://github.com/rhasspy/piper.git"
PIPER_REPO_COMMIT="73c04d81d5590ecc46e522de3601ce7fb29fc2be"

# Checkpoint oficial latinoamericano de calidad medium.
CHECKPOINT_NAME="es_MX-ald-medium"
CHECKPOINT_FILE="epoch=9999-step=1753600.ckpt"
CHECKPOINT_URL="https://huggingface.co/datasets/rhasspy/piper-checkpoints/resolve/main/es/es_MX/ald/medium/epoch%3D9999-step%3D1753600.ckpt?download=true"
CHECKPOINT_SHA256="77ee30f9a382594123ec4fb3ca53b437612819a44b3e3dc490f39f5a2dfefcce"
CHECKPOINT_SIZE_BYTES="845898456"

# Arquitectura y lenguaje: deben coincidir con el checkpoint.
VOICE_NAME="vader"
ESPEAK_VOICE="es-419"
SAMPLE_RATE="22050"
QUALITY="medium"

# RTX 3090 24 GB: configuración conservadora para priorizar estabilidad.
BATCH_SIZE="32"
PRECISION="32"
MAX_PHONEME_IDS="400"
VALIDATION_SPLIT="0.05"
PREPROCESS_WORKERS="2"

# El checkpoint base ya está en epoch 9999. Estos límites son absolutos.
SMOKE_MAX_EPOCHS="10010"
FULL_MAX_EPOCHS="11000"
CHECKPOINT_EVERY_EPOCHS="25"
FULL_MAX_TIME="01:12:00:00"

# Nombre de los artefactos finales para VaderMind/Raspberry.
MODEL_BASENAME="es_CL-vader-medium"
